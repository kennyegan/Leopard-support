# Local-only demo credentials; never use these for a public service.
DATABASE_URL=postgresql://techspot:local-demo-only@127.0.0.1:55432/techspot
# Options: scripted (offline), openrouter, gemini
PROVIDER=scripted
ALLOW_EXTERNAL_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Backend only; choose an OpenRouter model supporting structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
EXTERNAL_CALL_LIMIT=15
# Set only after explicit owner authorization for this exact synthetic corpus.
APPROVED_EXTERNAL_CORPUS_VERSION=
ADMIN_TOKEN=
WEB_ORIGIN=http://127.0.0.1:3000
EMBED_CACHE=.cache/fastembed
HIGH_SCORE=0.75
LOW_SCORE=0.55

# Default conversational demo; classic/v1 reproduces the historical pilot.
DIALOGUE_MODE=conversational
CORPUS_VERSION=synthetic-2026-10-v3
# External processing requires exact version approval AND an authorized DB spend grant.

# Deployment is opt-in and fails closed; demo remains loopback-only.
APP_MODE=demo
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PILOT_SUPPORT_CONTACT=
PILOT_QUALIFICATION=false
RETENTION_DAYS=30
LOGIN_HOURS=8
USER_REQUESTS_PER_MINUTE=60
USER_TURNS_PER_HOUR=20
GLOBAL_TURNS_PER_HOUR=200
INFERENCE_CONCURRENCY=10
INFERENCE_ENABLED=true
POOL_SIZE=12
OPENROUTER_ZDR=true
